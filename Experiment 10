#include <iostream>
using namespace std;

int main()
{
    float temperature;

    cout << "Enter temperature (0 to 100): ";
    cin >> temperature;

    try
    {
        if (temperature < 0 || temperature > 100)
            throw temperature;

        cout << "Valid temperature: " << temperature << endl;
    }
    catch (float t)
    {
        cout << "Exception caught!" << endl;
        cout << "Invalid temperature: " << t << endl;
        cout << "Temperature must be between 0 and 100." << endl;
    }

    return 0;
}
